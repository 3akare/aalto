# Applied by Workers static assets to every file it serves. The API sets its own
# headers in worker/index.ts.
#
# The page loads nothing from another origin - fonts are self-hosted on purpose -
# so the policy can be strict. The one exception is the voice socket.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://agents.assemblyai.com; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fonts and icons never change under the same name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
