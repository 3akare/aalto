{
  "name": "aalto-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env-file ../.env",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-file ../.env.example",
    "typecheck": "wrangler types --env-file ../.env.example && tsc -p .",
    "check": "npm run typecheck && wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.136.2"
  }
}
