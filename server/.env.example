# --- Intron / Sahara Voice AI (STT + TTS) ---
INTRON_API_KEY=
INTRON_BASE_URL=https://infer.voice.intron.io

# --- AssemblyAI (benchmark comparison model, and primary engine for the Sept 30 submission) ---
ASSEMBLYAI_API_KEY=

# --- Google Gemini (orchestration planner + benchmark comparison models) ---
# Use a PAID / no-train endpoint. The AI Studio free tier may train on submitted
# data, which both strains AfriSwitch's CC-BY-NC-SA licence and contaminates an
# evaluation-only benchmark for everyone downstream.
GEMINI_API_KEY=
# Flash-Lite is Google's recommendation for high-volume work that does not need
# deep reasoning, which is exactly what mapping a short transcript onto a fixed
# tool schema is. Roughly an order of magnitude cheaper than Flash per call, and
# every spoken command costs one planner call plus sometimes one summariser call.
GEMINI_PLANNER_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# --- HuggingFace (pulling the gated AfriSwitch corpus) ---
# Read token from https://huggingface.co/settings/tokens
# Access must be granted first at https://huggingface.co/datasets/intronhealth/AfriSwitch
HF_TOKEN=

# --- Todoist ---
TODOIST_API_TOKEN=

# --- Server ---
PORT=8787
# Shared secret the extension must send as X-Aalto-Key. Without this, anyone who can
# reach the port spends your API credits and writes to your Todoist.
AALTO_API_KEY=
# Comma-separated origin allowlist for CORS. Chrome extensions use chrome-extension://<id>.
AALTO_ALLOWED_ORIGINS=
