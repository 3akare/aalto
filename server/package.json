{
  "name": "aalto-server",
  "version": "0.1.0",
  "description": "Aalto voice browser agent - orchestrator, STT/TTS abstraction, Todoist integration, benchmark harness",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "test": "node --require ts-node/register/transpile-only --test src/**/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "corpus": "ts-node-dev --transpile-only --once src/benchmark/prepareCorpus.ts",
    "benchmark": "ts-node-dev --transpile-only --once src/benchmark/runBenchmark.ts",
    "smoke": "ts-node-dev --transpile-only --once src/benchmark/smoke.ts"
  },
  "dependencies": {
    "@doist/todoist-sdk": "^15.2.0",
    "@google/genai": "^2.22.0",
    "@huggingface/hub": "^2.17.1",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.3.0",
    "form-data": "^4.0.1",
    "hyparquet": "^1.30.1",
    "multer": "^2.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
