{
  "manifest_version": 3,
  "name": "Aalto \u2014 Voice Browser Agent",
  "version": "0.3.0",
  "description": "Speak to search, manage tabs, fill Google Forms, and update Todoist tasks \u2014 in code-switched language.",
  "permissions": ["tabs", "activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aalto"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Open Aalto and start listening"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content-forms.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
